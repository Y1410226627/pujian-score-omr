# 本地虚拟环境（含 homr 引擎与模型，不入库）
.venv/

# 本地 OMR 引擎（Audiveris 便携版，体积大，按需安装）
.tools/

# 前端测试依赖
node_modules/

# Python 缓存
__pycache__/
*.py[cod]

# 编辑器与系统文件
.DS_Store
Thumbs.db
*.log

# 浏览器自动化测试产物
.playwright-cli/

# 真实音色（采样音源）由 tools/install_soundfonts.py 下载到本机，体积大且是第三方作品，不进仓库
.assets/

# 渲染/生成的临时缓存（tests/generate_jianpu_pages.py 的可写回退目录）
.cache/

# 原始乐谱 PDF：受版权保护，且体积大，**不入库**。
# 复现测试所需的页面图已作为 PNG 放在 tests/fixtures/jianpu_pages/（体积小、可追溯）；
# 要换别人的谱，按 README「测试」一节的说明用 tests/generate_jianpu_pages.py 自己生成。
tests/fixtures/_source_*.pdf
*.pdf

